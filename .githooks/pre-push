#!/bin/sh
# pre-push hook: 推送前做 Jekyll 博客质量检查

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 博客推送前检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

FAILED=0
PYTHON_AVAILABLE=0
if command -v python3 >/dev/null 2>&1; then
    PYTHON_AVAILABLE=1
fi

# ── 1. 死链检查（站内） ──
echo ""
echo "📋 [1/4] 死链检查（站内）"
if [ $PYTHON_AVAILABLE -eq 1 ]; then
    python3 scripts/check_links.py --no-net
    if [ $? -ne 0 ]; then
        FAILED=1
    fi
else
    echo "   ⚠️  python3 未安装，跳过死链检查"
fi

# ── 2. YAML + 日期 + URL 冲突 ──
echo ""
echo "📋 [2/4] YAML front matter 校验"
echo "📋 [3/4] 日期一致性检查"
echo "📋 [4/4] URL 冲突检查"
if [ $PYTHON_AVAILABLE -eq 1 ]; then
    python3 scripts/pre-push-check.py
    if [ $? -ne 0 ]; then
        FAILED=1
    fi
else
    echo "   ⚠️  python3 未安装，跳过后续检查"
fi

# ── 汇总 ──
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -ne 0 ]; then
    echo "❌ 检查未通过，推送已阻止"
    echo "   修复后重试，或 git push --no-verify 跳过（不推荐）"
    exit 1
else
    echo "✅ 全部通过，继续推送"
    exit 0
fi
