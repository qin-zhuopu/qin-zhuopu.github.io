# 本机环境值。复制为 .env.local 后填入真实值：
#   cp .env.local.example .env.local
# .env.local 已在 .gitignore 中，不会进 git。
#
# 用法（shell）：
#   source .env.local && curl --proxy "$HTTP_PROXY" https://github.com
# 用法（一次性读取）：
#   HTTP_PROXY=$(grep -E '^HTTP_PROXY=' .env.local | cut -d= -f2-)

HTTP_PROXY=http://your-proxy-host:port
